{
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(npm run build*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(node --version*)",
      "Bash(npm ls*)"
    ],
    "deny": [
      "Bash(npm run db:push*)",
      "Bash(npx drizzle-kit push*)",
      "Bash(npm run deploy*)",
      "Bash(npx wrangler deploy*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.mjs\""
          }
        ]
      }
    ]
  }
}
